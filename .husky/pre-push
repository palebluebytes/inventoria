# Run the e2e suite before pushing — but skip it for a delete-only push, which
# ships no code and so has nothing to test. Git feeds one line per ref being
# pushed on stdin ("<local ref> <local sha> <remote ref> <remote sha>"); a
# deleted ref has an all-zero local sha. Run the suite if any ref is a real
# update, skip if every ref is a deletion.
has_update=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) has_update=1 ;; # contains a non-zero char → a real (non-delete) push
  esac
done

if [ "$has_update" -eq 0 ]; then
  echo "pre-push: delete-only push — skipping e2e"
  exit 0
fi

pnpm test:e2e
