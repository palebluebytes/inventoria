# TMDB API key (movie/TV search)
# Get your free key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Scraper proxy URL (link/metadata scraping + image proxying)
# Optional. The app defaults to its own same-origin /api/proxy?url=, which
# vite serves in development and the Worker serves in production (ADR-0070),
# so this only needs setting to point a build at some other proxy.
# Setting it BLANK is not "unset": a blank value disables the proxy, and the
# fetcher then throws rather than falling back.
# VITE_SCRAPER_PROXY_URL=/api/proxy?url=
